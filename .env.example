# Bhashini (bhashini.gov.in) ULCA API credentials — register for free at
# https://bhashini.gov.in to get these. Required for the /api/tts backend
# (server/index.js) to serve real neural TTS in Indian languages.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# Optional: override the default published ASR+NMT+TTS pipeline ID.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Port the TTS backend listens on. Vite's dev server proxies /api to this.
API_PORT=8787
