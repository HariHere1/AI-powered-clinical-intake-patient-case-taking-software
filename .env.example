# TTS backend config. The Node backend (server/index.js) calls a local
# Indic Parler-TTS inference service (tts_service/, self-hosted,
# open-source — see https://huggingface.co/ai4bharat/indic-parler-tts).

# ai4bharat/indic-parler-tts is a GATED Hugging Face model. To download it:
#   1. Create a free account at https://huggingface.co
#   2. Accept the model's terms at https://huggingface.co/ai4bharat/indic-parler-tts
#   3. Create an access token at https://huggingface.co/settings/tokens
#      (Read access is enough) and paste it below.
HF_TOKEN=

# URL of the Python TTS service started with `npm run tts-service`.
PARLER_SERVICE_URL=http://127.0.0.1:8788

# Port the Node TTS backend listens on. Vite's dev server proxies /api to this.
API_PORT=8787
