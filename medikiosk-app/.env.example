# ---- Postgres (Docker) ----
POSTGRES_USER=medikiosk_migrator
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=medikiosk
# Used by Prisma migrations (elevated role)
DATABASE_URL=postgresql://medikiosk_migrator:change_me_strong_password@localhost:5432/medikiosk
# Used by the running app at runtime (least-privilege role, created by prisma/init/001_app_role.sql)
APP_DATABASE_URL=postgresql://medikiosk_app:change_me_app_password@localhost:5432/medikiosk
APP_DB_PASSWORD=change_me_app_password

# ---- Auth secrets ----
JWT_SECRET=change_me_patient_jwt_secret_min_32_chars
STAFF_JWT_SECRET=change_me_staff_jwt_secret_min_32_chars

# ---- Patient OTP ----
# When true, OTP codes are returned in the API response and logged to the
# server console instead of being sent via SMS. There is no SMS provider
# wired up yet -- flip this to false and implement lib/otp/smsProvider.ts
# against a real provider (e.g. MSG91, Twilio) before going to production.
MOCK_OTP=true

# ---- LLM provider (adaptive follow-ups + report summarization) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Python microservices ----
STT_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8002
OCR_SERVICE_URL=http://localhost:8003
WHISPER_MODEL_SIZE=small

# ---- Misc ----
NODE_ENV=development
